msgctxt "fx.tooltip.eq_low"
msgid "Low shelf EQ at 120 Hz: boosts or cuts bass."
msgstr "120 Hz 低频搁架均衡：提升或削减低频。"

msgctxt "fx.tooltip.eq_mid"
msgid "Peaking EQ at 1 kHz: boosts or cuts the midrange."
msgstr "1 kHz 峰值均衡：提升或削减中频。"

msgctxt "fx.tooltip.eq_high"
msgid "High shelf EQ at 8 kHz: boosts or cuts treble."
msgstr "8 kHz 高频搁架均衡：提升或削减高频。"

msgctxt "fx.tooltip.reverb_mix"
